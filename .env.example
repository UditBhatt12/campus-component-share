# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Credentials (IIT Roorkee Campus Component Share)
MONGO_USER=uditbhatt1205_db_user
MONGO_PASS=uditlovesmango
MONGO_CLUSTER=cluster0.n8svkhd.mongodb.net
MONGO_DB_NAME=campus_component_share
MONGODB_URI=mongodb+srv://uditbhatt1205_db_user:uditlovesmango@cluster0.n8svkhd.mongodb.net/campus_component_share?retryWrites=true&w=majority&appName=Cluster0

# Local fallback URI if Atlas is unreachable or offline
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/campus_component_share
# Automatically fall back to local JSON document store (data/campus-db.json) if MongoDB is unreachable
DB_AUTO_FALLBACK=true

# JWT Authentication
JWT_SECRET=9f8d7a6b5c4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a
JWT_EXPIRES_IN=7d

# Campus Email Domain Restriction (IIT Roorkee: allows @iitr.ac.in and @*.iitr.ac.in like @ece.iitr.ac.in)
ENFORCE_CAMPUS_EMAIL=true
ALLOWED_EMAIL_DOMAINS=iitr.ac.in
CAMPUS_NAME=IIT Roorkee
